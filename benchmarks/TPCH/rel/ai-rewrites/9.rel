// Q9 -- Product Type Profit Measure
//   profit by nation and order year for parts whose name matches a pattern.

def profit(o, num, name, yr, v):
    exists((s, p, n) |
        l_suppkey(o, num, s) and s_nationkey(s, n) and n_name(n, name) and
        l_partkey(o, num, p) and like_match(raw"%@@1%", p_name[p])) and
    yr = date_year[o_orderdate[o]] and
    v = l_extendedprice[o, num] * (1 - l_discount[o, num])
        - ps_supplycost[l_partkey[o, num], l_suppkey[o, num]] * l_quantity[o, num]

def result[name, yr]: sum[(o, num, v): profit(o, num, name, yr, v)]
