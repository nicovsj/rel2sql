// Q12 -- Shipping Modes and Order Priority
//   per ship mode, how many lineitems belong to high- vs low-priority orders.
//   Both the mode list and the priority list are set literals, not OR chains.

def selected_shipmode { "@@1"; "@@2" }
def urgent_prio { "1-URGENT"; "2-HIGH" }

// Functional form, not relational: binding the three dates as variables and
// comparing them is catastrophically slower here (SF1: >120s vs 0.8s).  This is
// the one query where the usual "bind each attribute once" rule loses.
def sel(o, num, mode):
    l_shipmode(o, num, mode) and
    selected_shipmode(mode) and
    l_commitdate[o, num] < l_receiptdate[o, num] and
    l_shipdate[o, num] < l_commitdate[o, num] and
    parse_date["@@3", "Y-m-d"] <= l_receiptdate[o, num] and
    l_receiptdate[o, num] < parse_date["@@4", "Y-m-d"]

def high_prio(o): exists((p) | o_orderpriority(o, p) and urgent_prio(p))

// low = total - high rather than `not high_prio(o)`: the negation becomes
// NOT IN against a large set, which DuckDB does not turn into an anti-join.
def high_count[mode]: count[(o, num): sel(o, num, mode) and high_prio(o)]
def total_count[mode]: count[(o, num): sel(o, num, mode)]

def result[mode]: (high_count[mode], total_count[mode] - high_count[mode])
