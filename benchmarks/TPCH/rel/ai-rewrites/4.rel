// Q4 -- Order Priority Checking
//   count orders in a 3-month window having at least one late-committed lineitem.

def late_order(o):
    exists((num, cd, rd) | l_commitdate(o, num, cd) and l_receiptdate(o, num, rd) and cd < rd)

def selected_order(o):
    exists((od) | o_orderdate(o, od) and
        parse_date["@@1", "Y-m-d"] <= od and od < parse_date["@@2", "Y-m-d"]) and
    late_order(o)

def result[prio]: count[(o): o_orderpriority(o, prio) and selected_order(o)]
