// Q1 -- Pricing Summary Report
//   8 aggregates grouped by (l_returnflag, l_linestatus) over lineitems shipped
//   on or before 1998-12-01 minus DELTA days.
//
// `groups` carries every summable value, including the two derived ones, so each
// aggregate is a plain column sum over one relation.  The derived values use the
// functional form `l_extendedprice[o, num]` because arithmetic over relationally
// bound variables makes the translator re-derive its operands.

@inline def upper_shipdate[]: date_subtract[parse_date["1998-12-01", "Y-m-d"], ^Day[@@1]]

def groups(o, num, flag, status, qty, price, disc, revenue, charge):
    l_returnflag(o, num, flag) and
    l_linestatus(o, num, status) and
    l_quantity(o, num, qty) and
    l_extendedprice(o, num, price) and
    l_discount(o, num, disc) and
    exists((sd) | l_shipdate(o, num, sd) and sd <= upper_shipdate) and
    revenue = l_extendedprice[o, num] * (1 - l_discount[o, num]) and
    charge = l_extendedprice[o, num] * (1 - l_discount[o, num]) * (1 + l_tax[o, num])

def result[flag, status]: (
    sum[(o, num, v): groups(o, num, flag, status, v, _, _, _, _)],
    sum[(o, num, v): groups(o, num, flag, status, _, v, _, _, _)],
    sum[(o, num, v): groups(o, num, flag, status, _, _, _, v, _)],
    sum[(o, num, v): groups(o, num, flag, status, _, _, _, _, v)],
    average[(o, num, v): groups(o, num, flag, status, v, _, _, _, _)],
    average[(o, num, v): groups(o, num, flag, status, _, v, _, _, _)],
    average[(o, num, v): groups(o, num, flag, status, _, _, v, _, _)],
    count[(o, num): groups(o, num, flag, status, _, _, _, _, _)])
