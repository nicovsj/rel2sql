// Q14 -- Promotion Effect
//   share of revenue from promotional parts in a one-month shipping window.

def rev(o, num, v):
    exists((sd) | l_shipdate(o, num, sd) and
        parse_date["@@1", "Y-m-d"] <= sd and sd < parse_date["@@2", "Y-m-d"]) and
    v = l_extendedprice[o, num] * (1 - l_discount[o, num])

def promo_rev(o, num, v):
    rev(o, num, v) and like_match(raw"PROMO%", p_type[l_partkey[o, num]])

def promo_total[]: sum[(o, num, v): promo_rev(o, num, v)]
def all_total[]: sum[(o, num, v): rev(o, num, v)]

def result[]: 100.00 * promo_total / all_total
