// Q16 -- Parts/Supplier Relationship
//   how many distinct suppliers can supply each (brand, type, size) combination,
//   excluding one brand, one type prefix, and suppliers with complaints.
//   `type` is a reserved word in the grammar, hence `ptyp`.

def wanted_size {
    49; 14; 23; 45; 19; 3; 36; 9 }

def complaint_supplier {
    (s): like_match(raw"%Customer%Complaints%", s_comment[s])
}
def sel {
    (p, s, brand, ptyp, size):
    partsupp(p, s) and
    p_brand(p, brand) and not (brand = "Brand#45") and
    p_type(p, ptyp) and not like_match(raw"MEDIUM POLISHED%", ptyp) and
    p_size(p, size) and wanted_size(size) and
    not complaint_supplier(s)
}
def result {
    [brand, ptyp, size]: count[(s): exists((p) | sel(p, s, brand, ptyp, size))]
}
