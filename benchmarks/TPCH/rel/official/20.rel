// Q20 -- Potential Part Promotion
//   suppliers in a nation holding more than half a year's shipped quantity in stock.
//   The shipped total is its own def: an aggregate used inside an arithmetic
//   comparison gets re-derived once per operand position otherwise.

def forest_part {
    (p): like_match(raw"forest%", p_name[p])
}
def shipped_qty {
    [p, s]: sum[(o, l, q):
    l_partkey(o, l, p) and
    l_suppkey(o, l, s) and
    exists((sd) | l_shipdate(o, l, sd) and
        parse_date["1994-01-01", "Y-m-d"] <= sd and
        sd < date_add[parse_date["1994-01-01", "Y-m-d"], ^Year[1]]) and
    l_quantity(o, l, q)]
}
def excess_supplier {
    (s): exists((p) |
    partsupp(p, s) and forest_part(p) and
    ps_availqty[p, s] > 0.5 * shipped_qty[p, s])
}
def result {
    (name, addr): exists((s) |
    excess_supplier(s) and
    exists((n) | s_nationkey(s, n) and n_name(n, "CANADA")) and
    s_name(s, name) and s_address(s, addr))
}
