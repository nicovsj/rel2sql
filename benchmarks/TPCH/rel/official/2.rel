// Q2 -- Minimum Cost Supplier
//   for each qualifying part, the European supplier offering it at minimum cost.
//   `min_cost` is its own def so the minimum is built once rather than re-derived
//   per operand position of the comparison.

def europe_supplier {
    (s): exists((n, r) |
    s_nationkey(s, n) and n_regionkey(n, r) and r_name(r, "EUROPE"))
}
def eu_cost {
    (p, s, c): partsupp(p, s) and europe_supplier(s) and ps_supplycost(p, s, c)
}
def min_cost {
    [p]: min[(s, c): eu_cost(p, s, c)]
}
def target_part {
    (p): p_size(p, 15) and like_match(raw"%BRASS", p_type[p])
}
def unsorted {
    (acctbal, nname, sname, p, mfgr, addr, phone, comment): exists((s, c) |
    target_part(p) and
    eu_cost(p, s, c) and c = min_cost[p] and
    s_acctbal(s, acctbal) and
    s_name(s, sname) and
    exists((n) | s_nationkey(s, n) and n_name(n, nname)) and
    p_mfgr(p, mfgr) and
    s_address(s, addr) and
    s_phone(s, phone) and
    s_comment(s, comment))
}
def inside_rev_sort {
    [acctbal]: reverse_sort[unsorted[acctbal]]
}
def final_sort {
    reverse_sort[inside_rev_sort]
}
def result {
    (acctbal, sname, nname, p, mfgr, addr, phone, comment): exists((i, i1) |
    final_sort(i, acctbal, i1, nname, sname, p, mfgr, addr, phone, comment) and i <= 100)
}
