// Q15 -- Top Supplier
//   supplier(s) with the highest revenue in a quarter.

def rev {
    (o, num, s, v):
    l_suppkey(o, num, s) and
    exists((sd) | l_shipdate(o, num, sd) and
        parse_date["1996-01-01", "Y-m-d"] <= sd and sd < parse_date["1996-04-01", "Y-m-d"]) and
    v = l_extendedprice[o, num] * (1 - l_discount[o, num])
}
def total_revenue {
    [s]: sum[(o, num, v): rev(o, num, s, v)]
}
def max_revenue {
    max[(s, v): total_revenue(s, v)]
}
def result {
    (s, name, addr, phone, v):
    total_revenue(s, v) and v = max_revenue and
    s_name(s, name) and s_address(s, addr) and s_phone(s, phone)
}
