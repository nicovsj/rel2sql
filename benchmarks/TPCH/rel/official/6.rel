// Q6 -- Forecasting Revenue Change
//   sum(l_extendedprice * l_discount) over lineitems in a one-year window,
//   with discount in [d-0.01, d+0.01] and quantity < q.
//
// Ranges use the relational form so each attribute is scanned once; the product
// keeps the functional form so its operands carry the (o, num) key.

def lower_shipdate {
    parse_date["1994-01-01", "Y-m-d"]
}
def upper_shipdate {
    date_add[parse_date["1994-01-01", "Y-m-d"], ^Year[1]]
}
def result {
    sum[(o, num, v):
    exists((sd, disc, qty) |
        l_shipdate(o, num, sd) and lower_shipdate <= sd and sd < upper_shipdate and
        l_discount(o, num, disc) and 0.06 - 0.01 <= disc and disc <= 0.06 + 0.01 and
        l_quantity(o, num, qty) and qty < 24)
    and v = l_extendedprice[o, num] * l_discount[o, num]
]
}
