// Q7 -- Volume Shipping
//   revenue between two specific nations, by year, over a date window.
//   The nation pair is a set literal rather than an OR of equalities: a
//   disjunction over a bound variable expands into a UNION of the whole relation.

def wanted_pair {
    ("FRANCE", "GERMANY"); ("GERMANY", "FRANCE") }

def shipping {
    (o, num, sname, cname, yr, v):
    exists((s, c, sn, cn, sd) |
        l_suppkey(o, num, s) and s_nationkey(s, sn) and n_name(sn, sname) and
        o_custkey(o, c) and c_nationkey(c, cn) and n_name(cn, cname) and
        wanted_pair(sname, cname) and
        l_shipdate(o, num, sd) and
        parse_date["1995-01-01", "Y-m-d"] <= sd and sd <= parse_date["1996-12-31", "Y-m-d"]) and
    yr = date_year[l_shipdate[o, num]] and
    v = l_extendedprice[o, num] * (1 - l_discount[o, num])
}
def result {
    [sname, cname, yr]: sum[(o, num, v): shipping(o, num, sname, cname, yr, v)]
}
