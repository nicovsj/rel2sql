// Q21 -- Suppliers Who Kept Orders Waiting
//   suppliers who are the sole late supplier on a multi-supplier failed order.

def late {
    (o, num): exists((cd, rd) |
    l_commitdate(o, num, cd) and l_receiptdate(o, num, rd) and rd > cd)
}
def has_other_supplier {
    (o, num): exists((num2, s1, s2) |
    l_suppkey(o, num, s1) and l_suppkey(o, num2, s2) and not (s1 = s2))
}
def other_late {
    (o, num, num2):
    exists((s1, s2) | l_suppkey(o, num, s1) and l_suppkey(o, num2, s2) and not (s1 = s2)) and
    late(o, num2)
}
def waiting {
    (o, num, s):
    l_suppkey(o, num, s) and
    o_orderstatus(o, "F") and
    late(o, num) and
    has_other_supplier(o, num) and
    not exists((num2) | other_late(o, num, num2)) and
    exists((n) | s_nationkey(s, n) and n_name(n, "SAUDI ARABIA"))
}
def result {
    [name]: count[(o, num): exists((s) | waiting(o, num, s) and s_name(s, name))]
}
