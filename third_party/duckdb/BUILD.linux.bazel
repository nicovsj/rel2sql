load("@rules_cc//cc:cc_import.bzl", "cc_import")

package(default_visibility = ["//visibility:public"])

cc_import(
    name = "duckdb",
    hdrs = [
        "duckdb.h",
        "duckdb.hpp",
    ],
    includes = ["."],
    # The prebuilt libduckdb_static.a from the official Linux release is missing the
    # fastpforlib bitpacking translation unit (undefined references to
    # duckdb_fastpforlib::internal::__fastpackNN), so link the shared library instead,
    # mirroring the macOS config. The shared library ships in the same release archive.
    shared_library = "libduckdb.so",
)
