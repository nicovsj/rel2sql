load("@rules_cc//cc:cc_import.bzl", "cc_import")

package(default_visibility = ["//visibility:public"])

cc_import(
    name = "duckdb",
    hdrs = [
        "duckdb.h",
        "duckdb.hpp",
    ],
    includes = ["."],
    static_library = "libduckdb_static.a",
    # This one .a bundles DuckDB plus its vendored dependencies (yyjson, zstd, re2, utf8proc,
    # postgres_parser, ...) as several unity-build object files, and some of those files reference
    # symbols defined only in other files of the same archive. GNU ld resolves a static archive in
    # a single left-to-right pass, pulling in a member only when something already-included still
    # has an unresolved reference to it; that leaves these internal, archive-to-itself references
    # unresolved and fails the link with "undefined reference" for symbols the archive does define.
    # alwayslink pulls in every object file regardless, sidestepping the single-pass scan entirely.
    # Not needed on macOS (Apple's linker/lld handle this scan differently) but harmless there.
    alwayslink = True,
)
